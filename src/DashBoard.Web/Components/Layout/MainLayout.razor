@inherits LayoutComponentBase

<div class="page">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <i class="bi bi-hdd-rack-fill"></i>
            <span>DashBoard</span>
        </div>
        <NavMenu />
    </aside>

    <div class="main">
        <header class="top-row px-4">
            <span class="top-row-spacer"></span>
            <button type="button" class="theme-toggle" onclick="dashboardTheme.toggle()" title="Cambiar tema" aria-label="Cambiar tema claro/oscuro">
                <i class="bi bi-sun-fill theme-icon-light"></i>
                <i class="bi bi-moon-stars-fill theme-icon-dark"></i>
            </button>
        </header>

        <main class="content px-4">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
