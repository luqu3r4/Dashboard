@page "/salud"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using DashBoard.Modules.Salud
@using DashBoard.Modules.Salud.Api
@using DashBoard.Modules.Salud.Charts
@using DashBoard.Modules.Salud.Summary
@using Microsoft.Extensions.Options
@inject SaludApiClient Api
@inject IOptions<SaludOptions> Options
@inject TimeProvider Time
@inject SaludZone Zone

<PageTitle>Salud</PageTitle>

<h1 class="h3 mb-4">Salud</h1>

@if (_message is not null)
{
    <div class="alert alert-warning" role="alert">@_message</div>
}
else if (!_loaded)
{
    <p class="text-secondary" role="status">Cargando…</p>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 text-secondary"><i class="bi bi-person-walking me-2"></i>Pasos hoy</h2>
                    <p class="display-6 mb-2">@((_today?.Steps ?? 0).ToString("N0", Es))</p>
                    @if (_today?.StepsGoalPercent is { } pct)
                    {
                        <div class="progress" role="progressbar" aria-label="Progreso de pasos" aria-valuenow="@Pct(pct)" aria-valuemin="0" aria-valuemax="100" style="height: 6px">
                            <div class="progress-bar" style="width: @Pct(pct)%"></div>
                        </div>
                        <small class="text-secondary">@Pct(pct) % de @Options.Value.StepsPerDay!.Value.ToString("N0", Es)</small>
                    }
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 text-secondary"><i class="bi bi-geo-alt me-2"></i>Distancia hoy</h2>
                    <p class="display-6 mb-2">@((_today?.Km ?? 0).ToString("N1", Es)) km</p>
                    <small class="text-secondary">semana: @_weekKm.ToString("N1", Es) km</small>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 text-secondary"><i class="bi bi-lightning-charge me-2"></i>Entrenos esta semana</h2>
                    <p class="display-6 mb-2">
                        @WorkoutsDone
                        @if (WorkoutsGoal is { } wg)
                        {
                            <span class="fs-4 text-secondary">/ @wg</span>
                        }
                    </p>
                    @if (WorkoutsGoal is { } goal)
                    {
                        <div class="progress" role="progressbar" aria-label="Progreso de entrenos" aria-valuenow="@Pct(WorkoutsDone * 100.0 / goal)" aria-valuemin="0" aria-valuemax="100" style="height: 6px">
                            <div class="progress-bar" style="width: @Pct(WorkoutsDone * 100.0 / goal)%"></div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 text-secondary"><i class="bi bi-speedometer2 me-2"></i>Peso</h2>
                    @if (_weight is { } wt)
                    {
                        <p class="display-6 mb-2">@wt.CurrentKg.ToString("N1", Es) kg</p>
                        @if (wt.ChangeOver30Days is { } ch)
                        {
                            <small class="d-block text-secondary"><span class="@TrendClass(wt)">@SignedKg(ch)</span> en 30 días</small>
                        }
                        @if (wt.Date != _todayDate)
                        {
                            <small class="d-block text-secondary">medido el @wt.Date.ToString("dd/MM", Es)</small>
                        }
                        @if (PositiveKg(Options.Value.TargetWeightKg) is { } target && wt.DistanceToTarget is { } dist)
                        {
                            <small class="d-block text-secondary">@(dist > 0 ? $"a {dist.ToString("N1", Es)} kg del objetivo ({target.ToString("N1", Es)})" : "objetivo alcanzado")</small>
                        }
                    }
                    else
                    {
                        <p class="text-secondary mb-0">@SaludMessages.NoData</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12 col-lg-8">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <ul class="nav nav-pills" role="tablist">
                            @foreach (var (tab, label) in Tabs)
                            {
                                <li class="nav-item" role="presentation">
                                    <button type="button" role="tab" aria-selected="@(_tab == tab ? "true" : "false")" class="nav-link py-1 px-3 @(_tab == tab ? "active" : "")" @onclick="() => _tab = tab">@label</button>
                                </li>
                            }
                        </ul>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Periodo">
                            @foreach (var (p, label) in Periods)
                            {
                                <button type="button" class="btn @(_period == p ? "btn-primary" : "btn-outline-secondary")" disabled="@_loading" @onclick="() => SelectPeriod(p)">@label</button>
                            }
                        </div>
                    </div>
                    <h2 class="h6 text-secondary mb-2">@ChartTitle</h2>
                    @if (_loading)
                    {
                        <p class="text-secondary" role="status">Cargando…</p>
                    }
                    else if (_tab == ChartTab.Pasos)
                    {
                        <BarChart Points="_stepsSeries" Goal="@Positive(Options.Value.StepsPerDay)" AriaLabel="@ChartTitle" />
                    }
                    else if (_tab == ChartTab.Peso)
                    {
                        <LineChart Points="_weightSeries" Goal="@PositiveKg(Options.Value.TargetWeightKg)" AriaLabel="@ChartTitle" />
                    }
                    else
                    {
                        <BarChart Points="_workoutSeries" Goal="@Positive(Options.Value.WorkoutsPerWeek)" AriaLabel="@ChartTitle" />
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6 text-secondary"><i class="bi bi-list-check me-2"></i>Últimos entrenamientos</h2>
                    @if (_latest.Count == 0)
                    {
                        <p class="text-secondary mb-0">@SaludMessages.NoData</p>
                    }
                    else
                    {
                        <table class="table table-sm mb-0">
                            <tbody>
                                @foreach (var workout in _latest)
                                {
                                    <tr>
                                        <td class="text-secondary text-nowrap">@LocalDate(workout.Start)</td>
                                        <td>@workout.Title</td>
                                        <td class="text-secondary text-end text-nowrap">@workout.Minutes.ToString("N0", Es) min</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Es = new("es-ES");

    private enum ChartTab { Pasos, Peso, Entrenos }

    private static readonly (ChartTab Tab, string Label)[] Tabs =
    [
        (ChartTab.Pasos, "Pasos"),
        (ChartTab.Peso, "Peso"),
        (ChartTab.Entrenos, "Entrenos"),
    ];

    private static readonly (Period Period, string Label)[] Periods =
    [
        (Period.Days30, "30 días"),
        (Period.Days90, "90 días"),
        (Period.Year, "1 año"),
    ];

    /// <summary>Rango máximo (días, inclusivo) que admite el endpoint diario de SaludApi.</summary>
    private const int MaxRangeDays = 366;

    private readonly CancellationTokenSource _cts = new();
    private int _version;
    private bool _loaded;
    private bool _loading;
    private string? _message;
    private Period _period = Period.Days30;
    private ChartTab _tab = ChartTab.Pasos;
    private double _weekKm;
    private DateOnly _todayDate;

    private TodayStats? _today;
    private WeekWorkouts? _week;
    private WeightStats? _weight;
    private IReadOnlyList<Workout> _latest = [];
    private IReadOnlyList<ChartPoint> _stepsSeries = [];
    private IReadOnlyList<ChartPoint> _weightSeries = [];
    private IReadOnlyList<ChartPoint> _workoutSeries = [];

    private static int Pct(double value) => (int)Math.Clamp(value, 0, 100);

    private static int? Positive(int? value) => value is > 0 ? value : null;

    private static double? PositiveKg(double? value) => value is > 0 ? value : null;

    private int WorkoutsDone => _week?.Count ?? 0;

    private int? WorkoutsGoal => Positive(_week?.Goal);

    private static string SignedKg(double kg) => (kg > 0 ? "+" : "") + kg.ToString("N1", Es) + " kg";

    private static string TrendClass(WeightStats stats) => SaludSummary.Trend(stats) switch
    {
        WeightTrend.Good => "text-success",
        WeightTrend.Bad => "text-danger",
        _ => "",
    };

    private string ChartTitle => _tab switch
    {
        ChartTab.Pasos => _period == Period.Year ? "Pasos por día (media de cada semana)" : "Pasos por día",
        ChartTab.Peso => "Peso (kg)",
        _ => "Entrenamientos por semana",
    };

    private string LocalDate(DateTimeOffset start) =>
        TimeZoneInfo.ConvertTime(start, Zone.Zone).ToString("ddd dd/MM", Es);

    protected override async Task OnInitializedAsync()
    {
        var opts = Options.Value;
        var ct = _cts.Token;
        var today = _todayDate = SaludClock.Today(Time, Zone.Zone);
        var (from, to) = SaludSummary.Range(_period, today);
        var version = ++_version;

        var stepsToday = Api.GetDailyAsync("Steps", today, today, ct);
        var distanceWeek = Api.GetDailyAsync("Distance", SaludSummary.MondayOf(today), today, ct);
        var sessionsWeek = Api.GetDailyAsync("Workout", SaludSummary.MondayOf(today), today, ct);
        var weightsYear = Api.GetDailyAsync("Weight", today.AddDays(-365), today, ct);
        var workouts = Api.GetWorkoutsAsync(Time.GetUtcNow().AddDays(-90), ct);
        var evolution = LoadEvolutionAsync(_period, from, to, ct);

        try
        {
            await Task.WhenAll(stepsToday, distanceWeek, sessionsWeek, weightsYear, workouts, evolution);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        var evo = evolution.Result;
        _message = SaludMessages.For(
            new[]
            {
                stepsToday.Result.Status, distanceWeek.Result.Status, sessionsWeek.Result.Status,
                weightsYear.Result.Status, workouts.Result.Status,
            }.Concat(evo.Statuses));
        _loaded = true;
        if (_message is not null)
        {
            return;
        }

        _today = SaludSummary.Today(stepsToday.Result.Data!, distanceWeek.Result.Data!, today, opts.StepsPerDay);
        _weekKm = SaludSummary.WeekKm(distanceWeek.Result.Data!, today);
        _week = SaludSummary.CurrentWeek(sessionsWeek.Result.Data!, today, opts.WorkoutsPerWeek);
        _weight = SaludSummary.Weight(weightsYear.Result.Data!, today, opts.TargetWeightKg);
        _latest = SaludSummary.Latest(workouts.Result.Data!);
        ApplyEvolution(evo, version);
    }

    private async Task SelectPeriod(Period period)
    {
        if (period == _period || _loading)
        {
            return;
        }

        _period = period;
        _loading = true;
        var version = ++_version;
        var (from, to) = SaludSummary.Range(period, _todayDate);
        Evolution evo;
        try
        {
            evo = await LoadEvolutionAsync(period, from, to, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _loading = false;
        _message = SaludMessages.For(evo.Statuses);
        if (_message is null)
        {
            ApplyEvolution(evo, version);
        }
    }

    private sealed record Evolution(
        Period Period, DateOnly From, DateOnly To,
        SaludResult<IReadOnlyList<DailyValue>> Steps, SaludResult<IReadOnlyList<DailyValue>> Distance,
        SaludResult<IReadOnlyList<DailyValue>> Weights, SaludResult<IReadOnlyList<DailyValue>> Sessions)
    {
        public IEnumerable<SaludStatus> Statuses => [Steps.Status, Distance.Status, Weights.Status, Sessions.Status];
    }

    private async Task<Evolution> LoadEvolutionAsync(Period period, DateOnly from, DateOnly to, CancellationToken ct)
    {
        var steps = Api.GetDailyAsync("Steps", from, to, ct);
        var distance = Api.GetDailyAsync("Distance", from, to, ct);
        var weights = Api.GetDailyAsync("Weight", from, to, ct);
        // Las semanas empiezan en lunes, así que las sesiones se piden desde el lunes de `from`.
        var sessions = GetSessionsAsync(SaludSummary.MondayOf(from), to, ct);
        await Task.WhenAll(steps, distance, weights, sessions);
        return new Evolution(period, from, to, steps.Result, distance.Result, weights.Result, sessions.Result);
    }

    /// <summary>Sesiones diarias; si el rango supera el máximo de la API (1 año + días hasta el lunes) se divide en dos llamadas.</summary>
    private async Task<SaludResult<IReadOnlyList<DailyValue>>> GetSessionsAsync(DateOnly from, DateOnly to, CancellationToken ct)
    {
        if (to.DayNumber - from.DayNumber + 1 <= MaxRangeDays)
        {
            return await Api.GetDailyAsync("Workout", from, to, ct);
        }

        var split = to.AddDays(-(MaxRangeDays - 1));
        var early = Api.GetDailyAsync("Workout", from, split.AddDays(-1), ct);
        var late = Api.GetDailyAsync("Workout", split, to, ct);
        await Task.WhenAll(early, late);
        if (early.Result.Status != SaludStatus.Ok)
        {
            return early.Result;
        }

        if (late.Result.Status != SaludStatus.Ok)
        {
            return late.Result;
        }

        IReadOnlyList<DailyValue> all = [.. early.Result.Data!, .. late.Result.Data!];
        return SaludResult<IReadOnlyList<DailyValue>>.Ok(all);
    }

    private void ApplyEvolution(Evolution evo, int version)
    {
        if (version != _version)
        {
            return;
        }

        _stepsSeries = SaludSummary.StepsSeries(evo.Steps.Data!, evo.Distance.Data!, evo.From, evo.To, evo.Period);
        _weightSeries = SaludSummary.WeightSeries(evo.Weights.Data!);
        _workoutSeries = SaludSummary.WorkoutsPerWeek(evo.Sessions.Data!, evo.From, evo.To);
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
