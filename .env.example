# Copia este fichero a ".env" (no se versiona) y rellena los valores.

# Clave de consulta de SaludApi (SALUDAPI_QUERY_API_KEY del .env de SaludApi).
SALUD_API_KEY=

# Objetivos opcionales del módulo Salud. Déjalos vacíos o sin definir para desactivarlos.
# Pasos diarios objetivo (p. ej. 10000).
SALUD_STEPS_PER_DAY=
# Entrenamientos objetivo por semana (p. ej. 3).
SALUD_WORKOUTS_PER_WEEK=
# Peso objetivo en kg (p. ej. 75.5, con punto decimal).
SALUD_TARGET_WEIGHT_KG=
